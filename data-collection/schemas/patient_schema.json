{
  "schema_id": "SCHEMA_PATIENT_001",
  "schema_name": "Patient Data Schema",
  "version": "1.0",
  "created_date": "2026-09-15",
  "organization": "Addis Alem Hospital SBFR Team",
  "schema_type": "json-schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "patient_id",
    "first_name",
    "last_name",
    "date_of_birth",
    "gender",
    "phone_number",
    "address",
    "city",
    "visit_date",
    "visit_type",
    "presenting_complaint",
    "collector_name",
    "collector_id",
    "completion_date"
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "pattern": "^PAT_[0-9]{6}$",
      "description": "Unique patient identifier"
    },
    "first_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[a-zA-Z][a-zA-Z\\s'-]*$",
      "description": "Patient's first name"
    },
    "middle_name": {
      "type": "string",
      "minLength": 0,
      "maxLength": 50,
      "description": "Patient's middle name (optional)"
    },
    "last_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[a-zA-Z][a-zA-Z\\s'-]*$",
      "description": "Patient's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Patient's date of birth (YYYY-MM-DD)"
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120,
      "description": "Patient's age in years"
    },
    "gender": {
      "type": "string",
      "enum": ["Male", "Female", "Other"],
      "description": "Patient's gender"
    },
    "phone_number": {
      "type": "string",
      "pattern": "^\\+251[0-9]{9}$",
      "description": "Patient's primary phone number"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Patient's email address (optional)"
    },
    "address": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "Patient's residential address"
    },
    "city": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50,
      "description": "Patient's city or town"
    },
    "region": {
      "type": "string",
      "description": "Patient's region (optional)"
    },
    "visit_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date of current visit (YYYY-MM-DD)"
    },
    "visit_type": {
      "type": "string",
      "enum": ["New Patient", "Follow-up", "Emergency", "Referral"],
      "description": "Type of visit"
    },
    "presenting_complaint": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "description": "Patient's main complaint or reason for visit"
    },
    "insurance_provider": {
      "type": "string",
      "description": "Insurance provider name (optional)"
    },
    "insurance_policy_number": {
      "type": "string",
      "description": "Insurance policy number (optional)"
    },
    "collector_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Name of person collecting data"
    },
    "collector_id": {
      "type": "string",
      "pattern": "^COL_[0-9]{4}$",
      "description": "Staff ID of data collector"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date form was completed (YYYY-MM-DD)"
    },
    "collector_signature": {
      "type": "string",
      "description": "Signature or initials of data collector"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "patient_id": "PAT_000001",
      "first_name": "Abebe",
      "middle_name": "Bekele",
      "last_name": "Alemayehu",
      "date_of_birth": "1985-03-20",
      "age": 41,
      "gender": "Male",
      "phone_number": "+251911234567",
      "email": "abebe@example.com",
      "address": "123 Main Street, Apt 4B",
      "city": "Addis Ababa",
      "region": "Addis Ababa",
      "visit_date": "2026-09-15",
      "visit_type": "Follow-up",
      "presenting_complaint": "Follow-up for hypertension management",
      "insurance_provider": "Addis Ababa Health Insurance",
      "insurance_policy_number": "AAH123456",
      "collector_name": "Marta Tekle",
      "collector_id": "COL_0001",
      "completion_date": "2026-09-15",
      "collector_signature": "MT"
    }
  ]
}
